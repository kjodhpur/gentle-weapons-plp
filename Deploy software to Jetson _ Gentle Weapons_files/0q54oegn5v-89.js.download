(globalThis.TURBOPACK||(globalThis.TURBOPACK=[])).push(["object"==typeof document?document.currentScript:void 0,94909,(e,t,o)=>{"use strict";Object.defineProperty(o,"__esModule",{value:!0});var n={default:function(){return p},getImageProps:function(){return d}};for(var a in n)Object.defineProperty(o,a,{enumerable:!0,get:n[a]});let i=e.r(55682),r=e.r(8927),s=e.r(5500),l=i._(e.r(1948));function d(e){let{props:t}=(0,r.getImgProps)(e,{defaultLoader:l.default,imgConf:{deviceSizes:[640,750,828,1080,1200,1920,2048,3840],imageSizes:[32,48,64,96,128,256,384],qualities:[75],path:"/_next/image",loader:"default",dangerouslyAllowSVG:!1,unoptimized:!1}});for(let[e,o]of Object.entries(t))void 0===o&&delete t[e];return{props:t}}let p=s.Image},57688,(e,t,o)=>{t.exports=e.r(94909)},45070,e=>{"use strict";var t=e.i(43476),o=e.i(57688),n=e.i(22016),a=e.i(4570),i=e.i(71645);let r="#00ff88",s="#00e5ff",l="#ffb000",d="#a1a1a1",p=[{id:"gwos",index:"01",code:"gwos",name:"GWOS",kind:"PLATFORM · LINUX",tagline:"A Linux distribution purpose-built to run AI workloads in production.",body:"GWOS takes the Nvidia Jetson family of compute from developer kit to fielded, attestable compute. Immutable rootfs, A/B updates, signed OTA, kernel-locked CUDA, built for reliability. The things you'd expect from a production OS, but tuned for autonomy payloads in a sealed enclosure.",specs:["Immutable, attested rootfs · A/B partitions · atomic rollback","Pinned CUDA / TensorRT / cuDNN stack · kernel locked versioning","Signed OTA with delta updates over low-bandwidth links","TPM-backed boot, secure-element device identity, SBOM per image","FIPS 140-3 cryptographic track, CMMC L2 alignment roadmap"],applicationCategory:"SystemUtility",operatingSystem:"Linux",accent:r,asciiArt:`    ┌──────────────────────────────────┐
    │  JETSON ORIN / NX / NANO         │
    │  ┌────────────┐  ┌────────────┐  │
    │  │ GWOS KERNEL│  │ CUDA 12.x  │  │
    │  └────┬───────┘  └─────┬──────┘  │
    │       │  signed OTA    │         │
    │  ┌────▼────────────────▼──────┐  │
    │  │  IMMUTABLE ROOTFS \xb7 A/B    │  │
    │  └────────────┬───────────────┘  │
    │    attested boot \xb7 SBOM  \xb7 TPM   │
    └──────────────┬───────────────────┘
                   │
          [ FIELDED_DEVICES: ███ ]`,cmd:[{text:"gwos image build --target thor --profile autonomy"},{text:"→ sbom.cdx.json written · 1,482 components",color:d},{text:"→ signature: 0x7a3f..e901 · verified",color:r},{text:"gwos ota push --wave 1 --canary 3 --rollback auto"},{text:"[ DEPLOYED: 3/3 · HEALTHY ]",color:r}]},{id:"poolnet",index:"02",code:"poolnet",name:"Poolnet",kind:"NETWORK · EDGE_MESH",tagline:"An edge-first private mesh. Self-forming, encrypted, egress-optional.",body:"Poolnet is what your autonomy fleet talks over when the LTE is jammed, the satcom is politely degraded, and the TAK server is three valleys away. A next-generation overlay that discovers peers, heals partitions, and lets you reach any node from an operator laptop, a co-deployed drone, or a rack at home through untrusted network space.",specs:["Quantum-safe encrypted links · per-node keypairs · short-lived certs","Partition-tolerant · continues operating without backhaul","Policy-driven egress · optionally tethered to cloud","Operator-in-the-loop ACLs · audit trail · time-boxed access"],applicationCategory:"NetworkingApplication",operatingSystem:"Cross-platform",accent:s,asciiArt:`      NODE_01 ─── NODE_02 ─── NODE_03
         \\         │           /
          \\        │          /
           \\       │         /
            NODE_04 ─── NODE_05
                   │
          NODE_06 ─┴─ NODE_07
    ::::::::::::::::::::::::::::::::::
      link: p2p, encrypted, mesh
      egress: optional \xb7 tethered OK
      discovery: self-forming`,cmd:[{text:"poolnet up --identity node_04.key"},{text:"→ peers discovered: 6 · routes converged in 240ms",color:d},{text:"poolnet route --to fleet/uas-17 --via mesh"},{text:"→ link: p2p · enc: x25519+chacha20 · rtt: 38ms",color:s},{text:"[ BACKHAUL: OFFLINE · MESH: HEALTHY ]",color:r}]},{id:"poolboy",index:"03",code:"poolboy",name:"Poolboy",kind:"DEPLOYMENT · CONTROL_PLANE",tagline:"A deployment system for next-gen AI workloads on autonomous platforms.",body:"Poolboy delivers modern devops capabilities for shipping models and binaries to robots, UAS, and ground vehicles already in test and field-deployed scenarios. Canary to a single host, widen to a wave, confirm per-node signatures, and roll back when regressions happen. Works over Poolnet. Lands on GWOS. Treats every rollout like the live operation it is.",specs:["Fleet-scale rollouts · canary / wave / region targeting","Cryptographically signed, per-node acknowledged deploys","Atomic rollback to last-known-good on telemetry breach","Bandwidth-aware · resumable · works over intermittent links","Human-authorized go/no-go gates · multi-operator control"],applicationCategory:"DeveloperApplication",operatingSystem:"Cross-platform",accent:l,asciiArt:`  [PAYLOAD] weights.safetensors   128MB
     │
     ▼  manifest_signed
  [POOLBOY] ──▶ POOLNET ──▶ N x GWOS
     │
     ├─ rollout: canary → wave → fleet
     ├─ rollback: last_known_good
     └─ ack: cryptographic \xb7 per-node

    TARGET_FLEET: ROBOTS / UAS / GCV`,cmd:[{text:"poolboy rollout submit ./autonomy_v2.manifest"},{text:"→ target: UAS_FLEET_NORTH · 142 nodes",color:d},{text:"poolboy gate approve --operator op_07"},{text:"→ wave 1: 3/3 · wave 2: 18/18 · wave 3: 121/121",color:l},{text:"[ ROLLOUT: COMPLETE · ROLLBACK: ARMED ]",color:r}]}],c="#00ff88",m="#00e5ff",h="#ffb000",g=[{slug:"secure-boot",path:"/secure-boot",title:"Secure boot for NVIDIA Jetson edge AI | Gentle Weapons",description:"GWOS brings verified secure boot, signed images, and attested boot chains to NVIDIA Jetson production deployments for defense autonomy programs.",h1:"Secure boot",intro:"Secure boot is the baseline for fielded edge AI: every stage from power-on through payload execution must prove integrity before a mission asset runs inference, navigation, or comms software. Programs evaluating secure boot for NVIDIA Jetson often compare Canonical Ubuntu, NVIDIA reference flows, RidgeRun, TrainSec, and e-con Systems—but production autonomy needs more than a demo chain. GWOS is a hardened Linux distribution for Jetson with immutable rootfs, A/B partitions, signed OTA, and attested boot aligned to how defense integrators actually ship.",productSlug:"gwos",accent:c,sections:[{heading:"What secure boot must cover on Jetson",paragraphs:["A credible secure boot story spans the bootloader, kernel, device tree, and root filesystem—not just a one-time flash script. GWOS pins NVIDIA JetPack components with kernel-locked CUDA and TensorRT versions so attestation and rollback stay meaningful after the first OTA."],bullets:["Verified boot chain from power-on through rootfs mount","TPM-backed device identity and SBOM per image","Atomic rollback when attestation or health checks fail","Signed OTA over low-bandwidth, DDIL links"]},{heading:"Built for production, not developer kits",paragraphs:["Reference secure boot flows help you prototype. GWOS is purpose-built to run AI workloads in production on Jetson Orin, NX, and Nano—where kernel drift, unsigned updates, and CUDA breakage kill programs before they reach field test."]}],relatedPaths:["/immutable-linux","/signed-ota","/deploy-software-to-jetson"],alternativeSlugs:["ubuntu-core","yocto","kairos"]},{slug:"immutable-linux",path:"/immutable-linux",title:"Immutable Linux for Jetson edge deployment | Gentle Weapons",description:"GWOS is an immutable OS for NVIDIA Jetson—read-only rootfs, A/B updates, and signed OTA for defense autonomy at the edge.",h1:"Immutable Linux",intro:"Immutable Linux—and immutable OS approaches more broadly—treat the root filesystem as an artifact you ship, verify, and replace atomically rather than patch in place. Teams comparing Fedora Atomic, Kairos, NixOS, Ubuntu Core, and roll-your-own Yocto images for Jetson need the same guarantees in the field: no surprise package drift, predictable rollback, and an OS that survives contested networks. GWOS delivers immutable rootfs with A/B partitions on NVIDIA Jetson, tuned for autonomy payloads in sealed enclosures—not warehouse AMR or cloud-native dev loops.",productSlug:"gwos",accent:c,sections:[{heading:"Immutable OS vs. mutable production pain",paragraphs:["Mutable rootfs on field hardware invites configuration skew across a fleet. An immutable OS image means every node runs the same verified bits; updates swap partitions instead of apt-get in the bush."],bullets:["Read-only rootfs with explicit, signed update paths","A/B partitions for atomic promotion and rollback","Pinned NVIDIA JetPack stack—CUDA, TensorRT, cuDNN locked to the image","SBOM and attestation metadata shipped with every build"]},{heading:"Read-only root filesystem on Pi vs. production immutable OS",paragraphs:["Search traffic for read-only rootfs on Raspberry Pi surfaces DIY paths—raspi-config OverlayFS how-tos, boot-partition read-only toggles, Adafruit and forum guides, StackExchange threads, and community kiosk write-ups aimed at SD card corruption on consumer boards. Those patterns (OverlayFS, read-only boot partition, overlay root) solve a real problem; they are not a signed, fleet-verified immutable OS.","Gentle Weapons is Jetson-first: GWOS targets NVIDIA Jetson where defense autonomy programs field inference and sensor fusion. If your question is how to deploy software to Raspberry Pi at production cadence—not SSH, SCP, or a self-hosted GitHub Actions runner—see signed OTA and fleet management for A/B image promotion and remote software updates instead of hobby deploy loops."]}],relatedPaths:["/secure-boot","/signed-ota","/deploy-software-to-jetson"],alternativeSlugs:["ubuntu-core","yocto","kairos"]},{slug:"mesh-network",path:"/mesh-network",title:"Private mesh network for edge autonomy fleets | Gentle Weapons",description:"Poolnet is a private edge mesh—encrypted overlay, self-forming peers, partition-tolerant links for UAS, robotics, and DDIL operations.",h1:"Mesh network",intro:"A mesh network for autonomous systems must keep working when LTE is jammed, satcom degrades, and backhaul disappears. Buyers evaluating drone mesh network options—Meshmerize, Mobilicom, ZeroTier, BSS Holland, and similar—need encrypted peer links, partition healing, and operator reach without assuming a stable cloud anchor. Poolnet is an edge-first private mesh: self-forming, encrypted, egress-optional overlay built for defense autonomy fleets operating in disconnected, degraded, intermittent, and limited environments.",productSlug:"poolnet",accent:m,sections:[{heading:"Mesh that survives EW and geography",paragraphs:["Cloud-trained autonomy has no path home when the link dies. Poolnet discovers peers, routes around partitions, and lets operators reach any node from a co-deployed asset, a laptop at the edge, or a tethered egress when policy allows."],bullets:["Encrypted peer links with per-node keypairs","Partition-tolerant operation without mandatory backhaul","Policy-driven egress when a horizon link exists","Operator-in-the-loop ACLs and audit trails"]},{heading:"Interlocks with rollout and OS",paragraphs:["Poolnet carries signed manifests from Poolboy to GWOS nodes across the same mesh—deployment and connectivity share one contested-edge assumptions."]}],relatedPaths:["/fleet-management","/signed-ota"],alternativeSlugs:["meshmerize"]},{slug:"fleet-management",path:"/fleet-management",title:"Payload fleet management for defense autonomy | Gentle Weapons",description:"Poolboy is payload and OTA fleet management for robotics and UAS—signed rollouts, canary waves, and rollback when kubectl and cloud CD do not fit the field.",h1:"Fleet management",intro:"Fleet management for defense autonomy is not warehouse AMR orchestration or Boston Dynamics Spot fleet software—it is getting models, firmware, calibration, and signed payloads to robots, UAS, and ground vehicles already in test and field-deployed scenarios. Fleet deployment at scale means cryptographic acknowledgment per node, canary-to-wave promotion, and rollback when telemetry breaches—not a single kubectl apply from a cloud region. Poolboy is Gentle Weapons' deployment control plane for payload and OTA fleet operations over intermittent links, with human-authorized gates and last-known-good rollback.",productSlug:"poolboy",accent:h,sections:[{heading:"Robot fleet rollout without a cluster",paragraphs:["Shipping AI to a robot fleet is firmware, weights, sensors, radios, OTA, and a rollback plan that works when the operator is wearing gloves. Poolboy treats every rollout like the live operation it is—because for defense programs, it is."],bullets:["Canary, wave, and region targeting across mixed platforms","Cryptographically signed manifests with per-node ack","Atomic rollback to last-known-good on breach","Bandwidth-aware, resumable delivery over Poolnet"]},{heading:"Wrong job-to-be-done we skip",paragraphs:["We do not pretend to compete with warehouse AMR fleet tools, Microsoft fleet suites, or ground-logistics orchestration. Poolboy is built for payload OTA on autonomous defense platforms—not indoor pallet movers."]}],relatedPaths:["/signed-ota","/mesh-network","/deploy-software-to-jetson"],alternativeSlugs:["foundries-io","mender"]},{slug:"signed-ota",path:"/signed-ota",title:"Signed OTA for edge AI and Jetson fleets | Gentle Weapons",description:"Signed OTA updates for NVIDIA Jetson and edge AI devices—GWOS immutable images plus Poolboy fleet rollout with verified manifests and rollback.",h1:"Signed OTA",intro:"Signed OTA is how edge AI devices accept firmware and software updates without trusting the network in between. Teams comparing Foundries.io, Allxon, Avassa, Qbee, Mender, and in-house pipelines need verified manifests, delta delivery over low bandwidth, and rollback that works offline. Gentle Weapons combines GWOS signed image updates on Jetson with Poolboy fleet rollout—cryptographic verification end to end, A/B promotion on the OS side, and canary-to-wave orchestration on the payload side.",productSlug:"poolboy",secondaryProductSlug:"gwos",accent:h,sections:[{heading:"Firmware updates with verification, not hope",paragraphs:["OTA for edge AI devices must assume DDIL links and adversarial networks. Updates are signed, acknowledged per node, and paired with rollback paths—not silent auto-updates from a vendor cloud you do not control."],bullets:["GWOS: signed OS images, delta OTA, A/B rollback on Jetson","Poolboy: signed payload manifests, fleet waves, LKG rollback","Delivery over Poolnet when backhaul is unavailable","SBOM and attestation metadata carried with images"]},{heading:"One stack, two layers",paragraphs:["OS updates and model or application payloads often land on different cadences. GWOS and Poolboy interlock so integrators can reason about platform and payload independently while sharing signing and rollout discipline."]},{heading:"Production remote updates, not Pi hobby deploy",paragraphs:["Deploy software to Raspberry Pi SERPs skew toward SSH, VS Code Remote SSH, Docker, and CI runners—fine for bench work, not field rollback. Production edge programs instead need A/B image promotion and remote software updates with verification—the same discipline GWOS and Poolboy bring to Jetson fleets. See fleet management for payload waves and rollback policy."]}],relatedPaths:["/secure-boot","/immutable-linux","/fleet-management"],alternativeSlugs:["foundries-io","mender"]},{slug:"deploy-software-to-jetson",path:"/deploy-software-to-jetson",title:"Deploy software to Jetson | Gentle Weapons",description:"Deploy software to Jetson with JetPack SDK, containers, and fleet-at-scale rollout—GWOS, Poolnet, and Poolboy for AI-powered edge applications in production.",h1:"Deploy software to Jetson",intro:"Deploy software to Jetson is the live buyer query after the bench demo: how do you move from NVIDIA JetPack SDK and SDK Manager flashes to deploying AI-powered edge applications across a fleet at scale? Answers in the wild point to JetPack and container workflows—Docker and NGC images, balena and Portainer Edge for fleet ops—and forum threads on production modules and multi-device workshops. Fielded defense programs still need immutable OS, signed payloads, private mesh delivery, and operator-controlled rollback—not container push alone. Gentle Weapons integrates GWOS, Poolnet, and Poolboy for Jetson production beyond dev-kit flash.",productSlug:"gwos",secondaryProductSlug:"poolboy",accent:c,sections:[{heading:"JetPack SDK to fleet-at-scale rollout",paragraphs:["NVIDIA JetPack SDK and SDK Manager get modules provisioned. Shipping inference, perception, and autonomy payloads to many Jetson nodes—Orin production modules, carrier boards, DDIL field assets—needs pinned stacks, containers where appropriate, and rollout gates an operator can abort without SSH to every box."],bullets:["GWOS: production Linux image with kernel-locked JetPack components","Poolboy: signed manifest rollout—canary, wave, fleet at scale","Poolnet: reach nodes when cloud or balena-class backhaul is absent","Integrated rollback across OS and payload layers"]},{heading:"Containers plus platform discipline",paragraphs:["Container images from Docker or NGC are part of the story; they are not the whole production path. Enterprise Linux on Jetson—RHEL or SLES references in the SERP—still leaves payload verification, mesh delivery, and last-known-good rollback to the integrator. GWOS and Poolboy supply that layer for defense autonomy programs."]},{heading:"When to brief the stack",paragraphs:["If your program is past prototype and facing multi-node field test, procurement review, or fleet-at-scale rollout, request a briefing—we share technical specifications under NDA with qualified parties."]}],relatedPaths:["/immutable-linux","/signed-ota","/fleet-management"],alternativeSlugs:["balena"]}],f=[{slug:"gwos",path:"/platform/gwos",title:"GWOS — hardened Linux for NVIDIA Jetson | Gentle Weapons",description:"GWOS is production Linux for NVIDIA Jetson—immutable rootfs, secure boot, signed OTA, and pinned NVIDIA JetPack for defense autonomy.",categoryPaths:["/secure-boot","/immutable-linux","/signed-ota","/deploy-software-to-jetson"],alternativeSlugs:["ubuntu-core","yocto","kairos","balena"]},{slug:"poolnet",path:"/platform/poolnet",title:"Poolnet — private edge mesh network | Gentle Weapons",description:"Poolnet is an edge-first private mesh—encrypted, self-forming, egress-optional networking for defense autonomy fleets.",categoryPaths:["/mesh-network"],alternativeSlugs:["meshmerize"]},{slug:"poolboy",path:"/platform/poolboy",title:"Poolboy — payload fleet deployment control | Gentle Weapons",description:"Poolboy deploys AI payloads to autonomous platforms—signed rollouts, canary waves, and rollback for robotics and UAS fleets.",categoryPaths:["/fleet-management","/signed-ota","/deploy-software-to-jetson"],alternativeSlugs:["foundries-io","mender","balena"]}];[...g.map(e=>e.path),...[{slug:"ubuntu-core",path:"/alternatives/ubuntu-core",title:"Ubuntu Core alternative for Jetson edge AI | Gentle Weapons",description:"GWOS as an Ubuntu Core alternative—immutable Jetson Linux with signed OTA, attested boot, and defense autonomy deployment interlocks.",h1:"Ubuntu Core alternative",intro:"Ubuntu Core is a common immutable OS reference for embedded Linux—but defense autonomy on NVIDIA Jetson often needs tighter NVIDIA JetPack pinning, attested boot chains, and rollout interlocks with private mesh delivery. GWOS is Gentle Weapons' production Linux for Jetson: immutable rootfs, A/B updates, signed OTA, and integration with Poolnet and Poolboy for fielded fleets—not a generic snap-centric appliance model.",competitor:"Ubuntu Core",productSlug:"gwos",accent:c,categoryPath:"/immutable-linux",relatedAlternativeSlugs:["kairos","yocto"],sections:[{heading:"Where teams look beyond Ubuntu Core",paragraphs:["Programs choose Ubuntu Core for immutability and update discipline. On Jetson, they still face CUDA versioning, secure boot alignment, and fleet payload delivery that snaps alone do not solve."],bullets:["Jetson-first image with kernel-locked NVIDIA JetPack stack","Signed OTA with A/B rollback—not just package confinement","SBOM and attestation metadata per production image","Interlocks with Poolboy payload rollout and Poolnet mesh"]}]},{slug:"yocto",path:"/alternatives/yocto",title:"Yocto alternative for production Jetson images | Gentle Weapons",description:"GWOS as a Yocto alternative—production Jetson Linux without maintaining your own distro layer for every JetPack bump.",h1:"Yocto alternative",intro:"Yocto and OpenEmbedded give ultimate control—and unlimited maintenance. Many integrators start there for immutable OS and secure boot on Jetson, then stall on JetPack bumps, CUDA pinning, and OTA plumbing. GWOS is a production-ready alternative: hardened Linux for NVIDIA Jetson with immutable rootfs, signed OTA, and attested boot, maintained as a platform so your team focuses on autonomy payloads instead of distro sidequests.",competitor:"Yocto / OpenEmbedded",productSlug:"gwos",accent:c,categoryPath:"/immutable-linux",relatedAlternativeSlugs:["ubuntu-core","kairos"],sections:[{heading:"Control without the layer tax",paragraphs:["Rolling your own Yocto image makes sense once. Maintaining it across Jetson SKUs, JetPack releases, and field OTA policy is where programs lose quarters."],bullets:["Pre-integrated Jetson production image—not a from-scratch layer stack","Signed OTA and A/B rollback included","SBOM generation aligned to procurement review","Optional integration with Poolboy fleet rollout"]}]},{slug:"foundries-io",path:"/alternatives/foundries-io",title:"Foundries.io alternative for signed edge OTA | Gentle Weapons",description:"Gentle Weapons as a Foundries.io alternative—signed OTA for Jetson OS and autonomy payloads with DDIL-aware fleet rollout.",h1:"Foundries.io alternative",intro:"Foundries.io combines Linux platform and OTA for embedded fleets—a strong reference for signed updates and factory flows. Defense autonomy programs on Jetson often also need private mesh delivery, payload-orchestrated rollouts separate from OS cadence, and DDIL assumptions Foundries targets less explicitly. Gentle Weapons pairs GWOS signed OS updates with Poolboy payload fleet management over Poolnet—signed OTA end to end for edge AI devices without treating every rollout as a factory flash.",competitor:"Foundries.io",productSlug:"poolboy",accent:h,categoryPath:"/signed-ota",relatedAlternativeSlugs:["mender"],sections:[{heading:"Platform OTA plus payload orchestration",paragraphs:["OS updates and model or application payloads ship on different schedules. Poolboy handles canary-to-wave payload rollout with per-node ack; GWOS handles immutable OS promotion on Jetson."],bullets:["Separate OS and payload rollout planes that interlock","Delivery over encrypted mesh when backhaul is absent","Human-authorized go/no-go gates for field operations","Rollback to last-known-good on telemetry breach"]}]},{slug:"meshmerize",path:"/alternatives/meshmerize",title:"Meshmerize alternative for drone mesh networks | Gentle Weapons",description:"Poolnet as a Meshmerize alternative—private encrypted mesh for UAS and robotics with egress-optional, DDIL-aware routing.",h1:"Meshmerize alternative",intro:"Meshmerize and similar drone mesh network products focus on multi-hop connectivity for aerial and mobile fleets. Poolnet addresses the same job—private edge mesh for autonomy assets—with encrypted overlay, self-forming peers, partition tolerance, and policy-driven egress for defense programs that cannot assume always-on cloud paths. It interlocks with Poolboy rollouts and GWOS nodes on Jetson.",competitor:"Meshmerize",productSlug:"poolnet",accent:m,categoryPath:"/mesh-network",sections:[{heading:"Mesh built for contested edge",paragraphs:["Connectivity alone is not enough; mesh for defense autonomy must integrate with how you authorize operators, audit access, and deliver signed payloads across the same links."],bullets:["Encrypted peer mesh with optional tethered egress","Partition healing without mandatory backhaul","Operator ACLs and time-boxed access","Shared stack with signed OTA and OS attestation"]}]},{slug:"kairos",path:"/alternatives/kairos",title:"Kairos alternative for immutable edge OS | Gentle Weapons",description:"GWOS as a Kairos alternative—immutable Jetson Linux with NVIDIA JetPack pinning and defense autonomy deployment stack.",h1:"Kairos alternative",intro:"Kairos offers immutable, cloud-native OS patterns for edge and data center footprints. For NVIDIA Jetson production in defense autonomy, teams still need Jetson-specific secure boot, CUDA stack locking, and fleet payload delivery aligned to DDIL ops. GWOS is immutable Linux purpose-built for Jetson field deployment—with signed OTA, A/B rollback, and integration with Poolnet and Poolboy.",competitor:"Kairos",productSlug:"gwos",accent:c,categoryPath:"/immutable-linux",relatedAlternativeSlugs:["ubuntu-core","yocto"],sections:[{heading:"Immutable OS where you field inference",paragraphs:["Generic immutable OS tooling helps standardize images. GWOS applies that discipline to Jetson production—where autonomy payloads, not Kubernetes control planes, are the point."],bullets:["Immutable rootfs with A/B updates on Jetson hardware","Pinned NVIDIA JetPack components per image","Attested boot and SBOM for procurement review","Stack integration for mesh and payload rollout"]}]},{slug:"balena",path:"/alternatives/balena",title:"Balena alternative for Jetson fleet deploy | Gentle Weapons",description:"Gentle Weapons as a balena alternative—deploy software to Jetson fleets with signed payloads, GWOS, and DDIL-aware rollout over Poolnet.",h1:"Balena alternative",intro:"Balena appears alongside JetPack SDK and container tooling when buyers search how to deploy software to Jetson at fleet scale—pushing Docker-based releases to edge devices from a cloud dashboard. Defense autonomy programs often need the same fleet-at-scale ambition with signed manifests, immutable OS promotion on Jetson, operator go/no-go gates, and delivery when balena-style cloud paths are unavailable. Gentle Weapons pairs GWOS production Linux with Poolboy payload rollout over Poolnet—deploying AI-powered edge applications with rollback, not just container redeploy.",competitor:"balena",productSlug:"poolboy",accent:h,categoryPath:"/deploy-software-to-jetson",relatedAlternativeSlugs:[],sections:[{heading:"Fleet deploy beyond container push",paragraphs:["Container workflows help ship inference and perception stacks; contested-edge programs also require OS and payload verification, mesh reach, and last-known-good rollback tied to mission telemetry."],bullets:["Signed payload manifests with per-node acknowledgment","GWOS immutable Jetson images with A/B OS rollback","Poolnet delivery when cloud fleet backhaul is degraded","Human-authorized rollout waves for operational safety"]}]},{slug:"mender",path:"/alternatives/mender",title:"Mender alternative for Jetson OTA rollout | Gentle Weapons",description:"Gentle Weapons as a Mender alternative—signed Jetson OTA plus autonomy payload fleet rollout over private mesh.",h1:"Mender alternative",intro:"Mender is a widely used OTA client and management layer for embedded Linux—often evaluated for Jetson firmware updates and delta deploys. Defense autonomy programs frequently need OS OTA and model or binary payload rollout on the same DDIL-aware control plane, with mesh delivery and operator gates Mender does not target alone. Gentle Weapons combines GWOS signed OS updates with Poolboy fleet orchestration—an alternative when Jetson OTA must include payload waves, rollback, and encrypted reach without a data-center anchor.",competitor:"Mender",productSlug:"poolboy",accent:h,categoryPath:"/signed-ota",relatedAlternativeSlugs:["foundries-io"],sections:[{heading:"OTA plus payload fleet control",paragraphs:["Mender-class OTA solves device updates well. Fielded autonomy also needs signed manifest rollout for models and applications—with canary promotion and last-known-good rollback tied to mission telemetry."],bullets:["GWOS handles Jetson OS image OTA with A/B rollback","Poolboy handles payload fleet waves and per-node ack","Poolnet delivers both when backhaul is unavailable","Human-authorized rollout gates for operational safety"]}]}].map(e=>e.path),...f.map(e=>e.path)];let u="#a1a1a1",y="#6b6b6b",x="#00ff88";function b({w:e=12,h:o="0.9em",offset:n="0"}){return(0,t.jsx)("span",{style:{display:"inline-block",width:e,height:o,background:"#fff",verticalAlign:"baseline",transform:`translateY(${n})`,animation:"gw-blink 1s step-end infinite",marginLeft:6}})}function v({children:e,color:o="#fff",solid:n=!1}){return(0,t.jsx)("span",{style:{fontSize:10,letterSpacing:"0.22em",textTransform:"uppercase",border:`1px solid ${o}`,padding:"3px 8px",color:n?"#000":o,background:n?o:"transparent",whiteSpace:"nowrap",lineHeight:1.3},children:e})}function S({children:e,color:o=u}){return(0,t.jsx)("div",{style:{fontSiz